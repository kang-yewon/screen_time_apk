<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvClockTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:text="오후 12:00:00"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvClockDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2026년 01월 01일 (목)"
        android:textColor="#9AA0A6"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/tvRemaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:background="#1A1A1A"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text="남은 잠금 시간  00:00:00"
        android:textColor="#FF5252"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="FocusLock 실행 중입니다.\n무음 및 화면 고정이 유지됩니다."
        android:textColor="#666666"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnPhone"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_marginTop="52dp"
        android:backgroundTint="#1E88E5"
        android:text="전화 걸기"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnReturnLock"
        android:layout_width="220dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2A2A34"
        android:text="통화 후 잠금화면 복귀 (25초 뒤 자동복귀)"
        android:textColor="#CCCCCC"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
